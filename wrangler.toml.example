name = "bytego"
main = "src/index.ts"
compatibility_date = "2023-12-01"
# account_id = "your-cloudflare-account-id"

# Router
routes = [
	{ pattern = "bytego.yourdomain.com", custom_domain = true }
]

[vars]
# Security: set this with `npm run secret:put`
# Do not store AUTH_KEY in this file.

# Your custom domain (R2 CDN Domain)
PUBLIC_DOMAIN = "https://cdn.yourdomain.com"

# App Title
APP_TITLE = "ByteGo"

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS = "https://bytego.yourdomain.com,http://localhost:8787"

# Default upload path format
UPLOAD_PATH_FORMAT = "{year}/{month}/{day}/{randomkey16}{ext}"

# Optional root prefix for every uploaded object key
# UPLOAD_ROOT_PREFIX = "uploads"

# Delete behavior: "none" hides Delete, "soft" deletes local history, "hard" deletes R2 and local history
# DELETE_MODE = "soft"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "bytego"

[[rules]]
type = "Text"
globs = ["**/*.html"]
fallthrough = true
